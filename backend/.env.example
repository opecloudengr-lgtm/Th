# Copy to .env and fill in real values for your environment.

APP_NAME=Nexora
ENV=production
DEBUG=false
FRONTEND_URL=https://your-frontend-domain.example
BACKEND_URL=https://api.your-domain.example

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg2://user:password@host:5432/eventpass
REDIS_URL=redis://host:6379/0

# JSON array of allowed origins
CORS_ORIGINS=["https://your-frontend-domain.example"]

# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# SMTP for transactional email (verification, tickets, notifications).
# If left blank, emails are logged to stdout instead of sent (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=Nexora
SMTP_USE_TLS=true

# S3-compatible object storage for cover images/logos. If blank, files are
# stored on local disk under LOCAL_MEDIA_DIR (fine for a single-instance deploy).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
LOCAL_MEDIA_DIR=media

SUPER_ADMIN_EMAIL=admin@your-domain.example
