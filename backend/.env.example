# Copy to .env and fill in real values for your environment.
#
# Defaults below (DEBUG=true, blank SMTP) are for local/first-run testing --
# see the root README's "Quick start" sections. Before a real deployment,
# set ENV=production, DEBUG=false, and fill in FRONTEND_URL/BACKEND_URL/SMTP.

APP_NAME=Nexora
ENV=development
# DEBUG=true also enables GET /api/v1/dev/outbox, which lets you read
# verification/reset/ticket emails in the browser when SMTP isn't
# configured (see the frontend's /dev-outbox page). Set to false in
# production.
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg2://user:password@host:5432/eventpass
REDIS_URL=redis://host:6379/0

# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# SMTP for transactional email (verification, tickets, notifications).
# If left blank, emails are logged to stdout instead of sent (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=Nexora
SMTP_USE_TLS=true

# S3-compatible object storage for cover images/logos. If blank, files are
# stored on local disk under LOCAL_MEDIA_DIR (fine for a single-instance deploy).
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
LOCAL_MEDIA_DIR=media

SUPER_ADMIN_EMAIL=admin@your-domain.example
